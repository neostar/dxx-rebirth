# The fork's pinned toolchain (ADR 1, ticket #57): every developer and CI
# run builds with exactly these.  tools/dev/doctor.sh fails on any drift;
# tools/dev/deps.sh builds the dependency lines into the project prefix;
# tools/dev/container.sh builds the Linux reference image from the image
# lines.  Change a pin here, then rebuild with deps.sh.
#
# tool <name> <platform> <version>         platform: darwin, linux or any
# Homebrew supplies the Mac's tools, the Ubuntu snapshot the container's.
tool apple-clang darwin 21.0.0
# clangd, clang-format and clang-tidy: from the `prebuilt llvm` release
# below on both platforms, so one LLVM build.
tool llvm any 23.1.3
tool gcc linux 14.2.0
tool clang linux 19.1.1
tool ccache darwin 4.14.2
tool ccache linux 4.9.1
tool scons darwin 4.11.1
tool scons linux 4.5.2
tool uv any 0.13.1
tool cmake any 4.4.4
tool shellcheck any 0.11.0
#
# pkg <pkg-config module> <platform> <version>: the system libraries the
# legacy SDL1.2/SDL2 builds link (Homebrew on the Mac, the Ubuntu snapshot
# in the container); the source-built SDL3 stack below replaces them from
# the SDL3 build scaffold (#38) on.
pkg sdl2 darwin 2.32.74
pkg SDL2_image darwin 2.8.12
pkg SDL2_mixer darwin 2.8.2
pkg physfs darwin 3.2.0
pkg libpng darwin 1.6.59
pkg sdl darwin 1.2.78
pkg sdl2 linux 2.30.0
pkg SDL2_image linux 2.8.2
pkg SDL2_mixer linux 2.8.0
pkg physfs linux 3.0.2
pkg libpng linux 1.6.43
pkg sdl linux 1.2.68
pkg SDL_image linux 1.2.12
pkg SDL_mixer linux 1.2.12
#
# venv python <version>: deps.sh venv makes the venv with uv from this
# Python and tools/dev/requirements.lock (hashed); doctor.sh checks both.
venv python 3.13.16
#
# image <name> <reference pinned by digest>
image ubuntu ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac
image uv ghcr.io/astral-sh/uv:0.13.1@sha256:4a1f3666816dafadd20ceb71eac9a7d56d7ef30279f7d64048519ab901ada336
# apt in the container installs from this Ubuntu archive snapshot only.
image ubuntu-snapshot 20261020T000000Z
#
# Dependencies, built in this order.
# source <name> <version> <url> <sha256>: a release tarball.
# git <name> <commit> <url>: the commit, with its submodules at the commits
#   it records, is the pin.
source SDL3 3.4.18 https://github.com/libsdl-org/SDL/releases/download/release-3.4.18/SDL3-3.4.18.tar.gz 9c75cf16330322c217dedd2e0609f1124f1b54b8633e763467b4684d0f4334a3
# FluidSynth v2.6.1: its source archive lacks the gcem and signalsmith
# submodules, which its CMake would then download during the build.
git fluidsynth 71e85b2ca6bf48641ba7e2261d8f2640ae473773 https://github.com/FluidSynth/fluidsynth.git
# fetchcontent <name> <commit> <url>: replaces the CMake FetchContent
#   download of that name (here: FluidSynth's signalsmith-audio-basics
#   submodule, at its tags 0.3.1, v1.7.1 and 1.0.0).
fetchcontent signalsmith-linear 5668673560146a9cfe38c25315071e3fd68c8317 https://github.com/Signalsmith-Audio/linear.git
fetchcontent signalsmith-dsp 2d20161915e733f117545c6be8cd3275a739a1e3 https://github.com/Signalsmith-Audio/dsp.git
fetchcontent signalsmith-hilbert 9e42e09714c8215d51eaa1b52a3d54ae8dd2a3a3 https://github.com/Signalsmith-Audio/hilbert-iir.git
source SDL3_mixer 3.2.4 https://github.com/libsdl-org/SDL_mixer/releases/download/release-3.2.4/SDL3_mixer-3.2.4.tar.gz 182a07c745375e113dc740d43964ff21b0be29f29f59876c4dbc4db3d32f6901
source SDL3_image 3.4.8 https://github.com/libsdl-org/SDL_image/releases/download/release-3.4.8/SDL3_image-3.4.8.tar.gz e8223b424bc7541cf84ffff5cf7e4f24ec3711c60462cb1bd6dc1d7bd7f25477
git SDL_shadercross 1ff05bec573988a98ef9e0260b4da44f512b8367 https://github.com/libsdl-org/SDL_shadercross.git
# prebuilt <name> <platform> <url> <sha256>: a release archive for one
# platform.  DXC for DXIL, Linux x86-64 only.  LLVM's own release: deps.sh
# installs only clangd, clang-format, clang-tidy and clang's headers.
prebuilt llvm darwin-arm64 https://github.com/llvm/llvm-project/releases/download/llvmorg-23.1.3/LLVM-23.1.3-macOS-ARM64.tar.zst a3f181b1176406893c097443e21b2a54b85afeac2d10eca3b6d251e6dca32eb3
prebuilt llvm linux-x86_64 https://github.com/llvm/llvm-project/releases/download/llvmorg-23.1.3/LLVM-23.1.3-Linux-X64.tar.zst 14d2f701eb68fb799001bdea6231048f3990690fa2f406d563555ff8f744daba
prebuilt dxc linux-x86_64 https://github.com/microsoft/DirectXShaderCompiler/releases/download/v1.9.2609/linux_dxc_2026_09_28.x86_x64.tar.gz 96faadc7f5c282d2ffda49804beb4c3ee38127bc252b723234e3c5cdf7aa39a1
# gitleaks, the secret scanner of the pre-commit and check tiers: the
# release's program, unpacked into opt/gitleaks/bin.
prebuilt gitleaks darwin-arm64 https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_darwin_arm64.tar.gz b40ab0ae55c505963e365f271a8d3846efbc170aa17f2607f13df610a9aeb6a5
prebuilt gitleaks linux-x86_64 https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_linux_x64.tar.gz 551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
