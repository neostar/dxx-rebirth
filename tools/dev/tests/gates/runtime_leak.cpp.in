// Memory still allocated at exit, unreachable, found at run time.  The
// volatile pointer keeps the optimiser from removing the allocation.
// gate lsan: detected memory leaks
// gate leaks: 1 leak for
#include <cstdlib>

int main()
{
	void *volatile p{std::malloc(64)};
	const bool allocated{p != nullptr};
	p = nullptr;
	return allocated ? 0 : 1;
}
