// The representative fork file: the conventions' idioms, clean on every gate.
// SDL's void * is cast only in the SDL wrapper layer, void_cast_wrapper.cpp.in.
// gate tidy: pass
// gate strict: pass
#include <SDL3/SDL.h>
#include <array>
#include <cstdint>
#include <memory>
#include <span>
#include <utility>

void con_printf(int level, const char *fmt, ...) __attribute__((format(printf, 2, 3)));

namespace dcx {

/* Release an SDL handle with its SDL release function. */
template <auto release>
struct sdl_deleter
{
	template <typename T>
	void operator()(T *p) const
	{
		release(p);
	}
};

using sdl_window_ptr = std::unique_ptr<SDL_Window, sdl_deleter<&SDL_DestroyWindow>>;
using sdl_surface_ptr = std::unique_ptr<SDL_Surface, sdl_deleter<&SDL_DestroySurface>>;

enum class blend_mode : uint8_t
{
	opaque,
	additive,
};

struct vertex
{
	float x{0};
	float y{0};
};

[[nodiscard]]
static float sum_x(const std::span<const vertex> vertices)
{
	float total{0};
	for (const auto &v : vertices)
		total += v.x;
	return total;
}

/* A run-time index into a view: the hardened library traps it out of range. */
[[nodiscard]]
static float x_at(const std::span<const vertex> vertices, const std::size_t i)
{
	return vertices[i].x;
}

[[nodiscard]]
static blend_mode pick(const bool glow)
{
	return glow ? blend_mode::additive : blend_mode::opaque;
}

[[nodiscard]]
static sdl_surface_ptr make_surface(const int w, const int h)
{
	return sdl_surface_ptr{SDL_CreateSurface(w, h, SDL_PIXELFORMAT_RGBA8888)};
}

/* An SDL callback that ignores its userdata: a cast to void, not from it. */
static void on_quit(const void *const userdata, const SDL_MetalView view)
{
	static_cast<void>(userdata);
	(void)view;
}

[[nodiscard]]
static std::size_t count_moved(std::array<vertex, 3> vertices)
{
	const auto moved{std::move(vertices)};
	return moved.size();
}

}

int main()
{
	using namespace dcx;
	const std::array<vertex, 3> vertices{{{1, 2}, {3, 4}, {5, 6}}};
	const auto surface{make_surface(4, 4)};
	const sdl_window_ptr window{};
	const vertex v{};
	const auto total{sum_x(vertices) + x_at(vertices, 2) + v.x};
	const auto bytes{surface ? static_cast<std::size_t>(surface->pitch) : 0};
	con_printf(0, "%zu bytes, %zu moved", bytes, count_moved(vertices));
	on_quit(nullptr, nullptr);
	const bool ok{pick(total > 0) == blend_mode::additive && !window};
	return ok ? 0 : 1;
}
