// gpu_clean.cpp.in rendering to a texture made without the COLOR_TARGET
// usage: SDL does not check it, the driver's validation layer reports it
// (Metal: "doesn't specify MTLTextureUsageRenderTarget", Vulkan:
// VUID-VkImageMemoryBarrier-oldLayout-01208, after which lavapipe crashes).
// gate gpu: from the driver's validation layer
#include <SDL3/SDL.h>

constexpr SDL_GPUTextureUsageFlags plant_usage{SDL_GPU_TEXTUREUSAGE_SAMPLER};
static void plant_in_pass(SDL_GPURenderPass *) {}
#include "gpu_probe.h.in"
