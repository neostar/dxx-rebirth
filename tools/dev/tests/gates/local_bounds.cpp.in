// A local array read far past its end through a pointer: beyond
// AddressSanitizer's redzone, so ASan misses it, and with the array's bounds
// not in the indexing expression's type, so UBSan's bounds check misses it
// too; only its local-bounds check, which knows the array, reports it.
// gate ubsanclang: access out of bounds
static int element(const int *values, const int index)
{
	return values[index];
}

int main(const int argc, char **)
{
	const int values[4]{1, 2, 3, 4};
	return element(values, argc + 63);
}
