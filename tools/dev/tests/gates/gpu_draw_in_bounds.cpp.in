// gpu_draw_out_of_bounds.cpp.in reading in bounds: the same headless
// SDL_GPU draw, its Metal fragment shader reading only the four values of
// its 16-byte storage buffer, passes, so that the plant fails for its
// out-of-bounds read alone.
// gate gpumetal: pass
#include <SDL3/SDL.h>
#include <cstdio>

static constexpr char vertex_shader[]{R"(#include <metal_stdlib>
using namespace metal;
vertex float4 plant_vertex(uint id [[vertex_id]])
{
	return float4(id == 1 ? 3.0 : -1.0, id == 2 ? 3.0 : -1.0, 0.0, 1.0);
}
)"};

static constexpr char fragment_shader[]{R"(#include <metal_stdlib>
using namespace metal;
fragment float4 plant_fragment(const device uint *values [[buffer(0)]],
	float4 pos [[position]])
{
	return float4(float(values[uint(pos.x) % 4]), 0.0, 0.0, 1.0);
}
)"};

static SDL_GPUShader *plant_shader(SDL_GPUDevice *const dev, const char *const code,
	const size_t size, const char *const entry, const SDL_GPUShaderStage stage,
	const Uint32 storage_buffers)
{
	SDL_GPUShaderCreateInfo info{};
	info.code = reinterpret_cast<const Uint8 *>(code);
	info.code_size = size - 1;
	info.entrypoint = entry;
	info.format = SDL_GPU_SHADERFORMAT_MSL;
	info.stage = stage;
	info.num_storage_buffers = storage_buffers;
	return SDL_CreateGPUShader(dev, &info);
}

int main()
{
	SDL_SetHint(SDL_HINT_MAC_BACKGROUND_APP, "1");
	if (!SDL_Init(SDL_INIT_VIDEO))
	{
		std::fprintf(stderr, "probe: SDL_Init: %s\n", SDL_GetError());
		return 1;
	}
	SDL_GPUDevice *const dev{SDL_CreateGPUDevice(SDL_GPU_SHADERFORMAT_MSL, true, nullptr)};
	if (!dev)
	{
		std::fprintf(stderr, "probe: SDL_CreateGPUDevice: %s\n", SDL_GetError());
		return 1;
	}
	/* Created with debug_mode true: gpu-validate.sh looks for this line. */
	std::fprintf(stderr, "sdlgpu: debug mode on\n");
	SDL_GPUShader *const vs{plant_shader(dev, vertex_shader, sizeof(vertex_shader),
		"plant_vertex", SDL_GPU_SHADERSTAGE_VERTEX, 0)};
	SDL_GPUShader *const fs{plant_shader(dev, fragment_shader, sizeof(fragment_shader),
		"plant_fragment", SDL_GPU_SHADERSTAGE_FRAGMENT, 1)};
	SDL_GPUColorTargetDescription color{};
	color.format = SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM;
	SDL_GPUGraphicsPipelineCreateInfo pinfo{};
	pinfo.vertex_shader = vs;
	pinfo.fragment_shader = fs;
	pinfo.primitive_type = SDL_GPU_PRIMITIVETYPE_TRIANGLELIST;
	pinfo.target_info.color_target_descriptions = &color;
	pinfo.target_info.num_color_targets = 1;
	SDL_GPUGraphicsPipeline *const pipeline{SDL_CreateGPUGraphicsPipeline(dev, &pinfo)};
	SDL_GPUTextureCreateInfo tinfo{};
	tinfo.type = SDL_GPU_TEXTURETYPE_2D;
	tinfo.format = SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM;
	tinfo.usage = SDL_GPU_TEXTUREUSAGE_COLOR_TARGET;
	tinfo.width = 16;
	tinfo.height = 16;
	tinfo.layer_count_or_depth = 1;
	tinfo.num_levels = 1;
	SDL_GPUTexture *const target_texture{SDL_CreateGPUTexture(dev, &tinfo)};
	SDL_GPUBufferCreateInfo binfo{};
	binfo.usage = SDL_GPU_BUFFERUSAGE_GRAPHICS_STORAGE_READ;
	binfo.size = 16;
	SDL_GPUBuffer *const buffer{SDL_CreateGPUBuffer(dev, &binfo)};
	SDL_GPUCommandBuffer *const cmd{SDL_AcquireGPUCommandBuffer(dev)};
	SDL_GPUColorTargetInfo target{};
	target.texture = target_texture;
	target.load_op = SDL_GPU_LOADOP_CLEAR;
	target.store_op = SDL_GPU_STOREOP_STORE;
	SDL_GPURenderPass *const pass{SDL_BeginGPURenderPass(cmd, &target, 1, nullptr)};
	SDL_BindGPUGraphicsPipeline(pass, pipeline);
	SDL_BindGPUFragmentStorageBuffers(pass, 0, &buffer, 1);
	SDL_DrawGPUPrimitives(pass, 3, 1, 0, 0);
	SDL_EndGPURenderPass(pass);
	SDL_SubmitGPUCommandBuffer(cmd);
	SDL_WaitForGPUIdle(dev);
	SDL_ReleaseGPUBuffer(dev, buffer);
	SDL_ReleaseGPUTexture(dev, target_texture);
	SDL_ReleaseGPUGraphicsPipeline(dev, pipeline);
	SDL_ReleaseGPUShader(dev, fs);
	SDL_ReleaseGPUShader(dev, vs);
	SDL_DestroyGPUDevice(dev);
	SDL_Quit();
	return 0;
}
